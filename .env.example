# Copy thành .env rồi sửa

# DB: để trống = SQLite cục bộ (portal.db). Dùng DB online thì dán chuỗi kết nối Postgres
# (Supabase, Neon...), ví dụ: postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///portal.db

# 1 = giả lập, không gọi controller thật (dùng cho bước test đầu). Đổi 0 khi test thật.
UNIFI_MOCK=1

# Controller UniFi (hosted). Kiểm tra lại URL/cổng với nhà cung cấp.
UNIFI_BASE=https://try.unifi.unihosted.com:8443
UNIFI_USER=portal_api
UNIFI_PASS=doi_mat_khau
# 1 nếu controller là UniFi OS (UDM, Cloud Key Gen2...), 0 nếu là controller cài tay
UNIFI_OS=0
# 0 nếu controller dùng chứng chỉ tự ký
UNIFI_VERIFY_TLS=1

# Tên site nội bộ của UniFi, dùng khi redirect không kèm site (thường là default)
UNIFI_SITE=default

# Thời hạn mỗi phiên (phút) và số lần nhập sai tối đa trong 10 phút
SESSION_MINUTES=480
MAX_FAILS=5

# Giao diện portal (logo và ảnh nền đặt trong thư mục static/: logo.png, bg.jpg)
BRAND_TITLE=Xin chào
BRAND_SUBTITLE=Chào mừng bạn đến với WiFi miễn phí
FOOTER_TEXT=Free WiFi
BRAND_COLOR=#e02020
